generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Rent {
  id          Int          @id @default(autoincrement()) @map("Id")
  employeeId  Int          @map("EmpleadoId")
  vehicleId   Int          @map("VehiculoId")
  customerId  Int          @map("ClienteId")
  rentDate    DateTime     @default(now()) @map("FechaInicio")
  returnDate  DateTime     @map("FechaFin")
  dailyRate   Float        @map("PrecioPorDia")
  days        Int          @map("TotalDias")
  comments    String?      @db.VarChar(500) @map("Comentarios")
  status      String       @db.VarChar(20) @map("Estado")
  customer    Customer     @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  employee    Employee     @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onUpdate: NoAction)
  inspections Inspection[]

  @@map("Alquiler")
}

model Customer {
  id          Int          @id @default(autoincrement()) @map("Id")
  cedula      String       @unique @db.VarChar(20) @map("Cedula")
  name        String       @db.VarChar(100) @map("Nombre")
  apellido    String       @db.VarChar(100) @map("Apellido")
  telefono    String?      @db.VarChar(20) @map("Telefono")
  email       String?      @db.VarChar(100) @map("Email")
  direccion   String?      @db.VarChar(255) @map("Direccion")
  licencia    String?      @db.VarChar(50) @map("LicenciaNumero")
  status      Boolean      @default(true) @map("Estado")
  createdAt   DateTime     @default(now()) @db.Date @map("FechaRegistro")
  rents       Rent[]
  inspections Inspection[]

  @@map("Clientes")
}

model FuelType {
  id          Int       @id @default(autoincrement()) @map("Id")
  description String    @db.VarChar(50) @map("Descripcion")
  status      Boolean   @default(true) @map("Estado")
  vehicles    Vehicle[]

  @@map("Combustibles")
}

model Employee {
  id          Int          @id @default(autoincrement()) @map("Id")
  cedula      String       @unique @db.VarChar(20) @map("Cedula")
  name        String       @db.VarChar(100) @map("Nombre")
  apellido    String       @db.VarChar(100) @map("Apellido")
  telefono    String?      @db.VarChar(20) @map("Telefono")
  email       String?      @db.VarChar(100) @map("Email")
  cargo       String?      @db.VarChar(100) @map("Cargo")
  status      Boolean      @default(true) @map("Estado")
  hireDate    DateTime     @default(now()) @db.Date @map("FechaAlta")
  rents       Rent[]
  inspections Inspection[]

  @@map("Empleados")
}

model Inspection {
  id             Int      @id @default(autoincrement()) @map("Id")
  rentId         Int      @map("AlquilerId")
  vehicleId      Int      @map("VehiculoId")
  employeeId     Int      @map("EmpleadoId")
  customerId     Int      @map("ClienteId")
  tipoInspeccion String   @db.VarChar(20) @map("TipoInspeccion")
  nivelCombust   String?  @db.VarChar(20) @map("NivelCombust")
  kilometrajeKm  Int?     @map("KilometrajeKm")
  tieneRayones   Boolean  @default(false) @map("TieneRayones")
  tieneGolpes    Boolean  @default(false) @map("TieneGolpes")
  tieneRoturas   Boolean  @default(false) @map("TieneRoturas")
  observaciones  String?  @db.VarChar(500) @map("Observaciones")
  inspectionDate DateTime @default(now()) @map("FechaInspeccion")
  status         String   @db.VarChar(20) @map("Estado")
  rent           Rent     @relation(fields: [rentId], references: [id], onUpdate: NoAction)
  employee       Employee @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onUpdate: NoAction)
  customer       Customer @relation(fields: [customerId], references: [id], onUpdate: NoAction)

  @@map("Inspecciones")
}

model Brand {
  id          Int       @id @default(autoincrement()) @map("Id")
  description String    @db.VarChar(100) @map("Nombre")
  status      Boolean   @default(true) @map("Estado")
  models      Model[]
  vehicles    Vehicle[]

  @@map("Marcas")
}

model Model {
  id            Int         @id @default(autoincrement()) @map("Id")
  name          String      @db.VarChar(100) @map("Nombre")
  brandId       Int         @map("MarcaId")
  vehicleTypeId Int         @map("TipoVehiculoId")
  status        Boolean     @default(true) @map("Estado")
  brand         Brand       @relation(fields: [brandId], references: [id], onUpdate: NoAction)
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onUpdate: NoAction)
  vehicles      Vehicle[]

  @@map("Modelos")
}

model VehicleType {
  id          Int       @id @default(autoincrement()) @map("Id")
  description String    @db.VarChar(100) @map("Descripcion")
  status      Boolean   @default(true) @map("Estado")
  models      Model[]
  vehicles    Vehicle[]

  @@map("TipoVehiculos")
}

model Vehicle {
  id            Int          @id @default(autoincrement()) @map("Id")
  placa         String       @unique @db.VarChar(20) @map("Placa")
  modelId       Int          @map("ModeloId")
  brandId       Int          @map("BrandId")
  vehicleTypeId Int          @map("TipoVehiculoId")
  fuelTypeId    Int          @map("CombustibleId")
  anio          Int          @map("Anio")
  color         String       @db.VarChar(50) @map("Color")
  noChasis      String       @db.VarChar(50) @map("NoChasis")
  noMotor       String       @db.VarChar(50) @map("NoMotor")
  dailyRate     Decimal      @db.Decimal(10, 2) @map("PrecioPorDia")
  available     Boolean      @default(true) @map("Disponible")
  status        Boolean      @default(true) @map("Estado")
  rents         Rent[]
  inspections   Inspection[]
  fuelType      FuelType     @relation(fields: [fuelTypeId], references: [id], onUpdate: NoAction)
  model         Model        @relation(fields: [modelId], references: [id], onUpdate: NoAction)
  brand         Brand        @relation(fields: [brandId], references: [id], onUpdate: NoAction)
  vehicleType   VehicleType  @relation(fields: [vehicleTypeId], references: [id], onUpdate: NoAction)

  @@map("Vehiculos")
}