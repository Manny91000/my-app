generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model VehicleType {
  id          Int       @id @default(autoincrement())
  description String    @db.VarChar(100)
  status      String    @db.VarChar(20)
  vehicles    Vehicle[]

  @@index([description])
}

model Brand {
  id          Int       @id @default(autoincrement())
  description String    @db.VarChar(100)
  status      String    @db.VarChar(20)
  models      Model[]
  vehicles    Vehicle[]

  @@index([description])
}

model Model {
  id          Int       @id @default(autoincrement())
  brandId     Int
  description String    @db.VarChar(100)
  status      String    @db.VarChar(20)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicles    Vehicle[]

  @@index([description])
}

model FuelType {
  id          Int       @id @default(autoincrement())
  description String    @db.VarChar(100)
  status      String    @db.VarChar(20)
  vehicles    Vehicle[]

  @@index([description])
}

model Vehicle {
  id            Int          @id @default(autoincrement())
  description   String       @db.VarChar(255)
  chassisNumber String       @db.VarChar(50)
  engineNumber  String       @db.VarChar(50)
  plateNumber   String       @db.VarChar(20)
  vehicleTypeId Int
  brandId       Int
  modelId       Int
  fuelTypeId    Int
  status        String       @db.VarChar(20)
  inspections   Inspection[]
  rents         Rent[]
  brand         Brand        @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fuelType      FuelType     @relation(fields: [fuelTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model         Model        @relation(fields: [modelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleType   VehicleType  @relation(fields: [vehicleTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Customer {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(100)
  documentId  String       @unique @db.VarChar(20)
  creditCard  String       @db.VarChar(20)
  creditLimit Float
  personType  String       @db.VarChar(20)
  status      String       @db.VarChar(20)
  inspections Inspection[]
  rents       Rent[]
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(50)
  employees Employee[]
}

model Employee {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(100)
  documentId    String       @unique @db.VarChar(20)
  workShift     String       @db.VarChar(20)
  commissionPct Float
  hireDate      DateTime     @default(now())
  status        String       @db.VarChar(20)
  roleId        Int
  email         String       @unique @db.VarChar(100)
  password      String       @db.VarChar(255)
  role          Role         @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inspections   Inspection[]
  rents         Rent[]
}

model Inspection {
  id             Int      @id @default(autoincrement())
  transactionId  Int
  vehicleId      Int
  customerId     Int
  scratches      Boolean  @default(false)
  fuelAmount     String   @db.VarChar(20)
  hasSpareTire   Boolean  @default(false)
  hasJack        Boolean  @default(false)
  hasGlassDamage Boolean  @default(false)
  tireStatus     String   @db.VarChar(50)
  inspectionDate DateTime @default(now())
  employeeId     Int
  status         String   @db.VarChar(20)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Rent {
  id         Int      @id @default(autoincrement())
  employeeId Int
  vehicleId  Int
  customerId Int
  rentDate   DateTime @default(now())
  returnDate DateTime
  dailyRate  Float
  days       Int
  comments   String?  @db.VarChar(500)
  status     String   @db.VarChar(20)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vehicleId])
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
}