generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Rent {
  id          Int          @id @default(autoincrement()) @map("Id")
  employeeId  Int          @map("EmpleadoId")
  vehicleId   Int          @map("VehiculoId")
  customerId  Int          @map("ClienteId")
  rentDate    DateTime     @default(now()) @map("FechaInicio")
  returnDate  DateTime     @map("FechaFin")
  dailyRate   Float        @map("PrecioPorDia")
  days        Int          @map("TotalDias")
  comments    String?      @map("Comentarios") @db.VarChar(500)
  status      String       @map("Estado") @db.VarChar(20)
  customer    Customer     @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  employee    Employee     @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onUpdate: NoAction)
  inspections Inspection[]

  @@map("Alquiler")
}

model Customer {
  id          Int          @id @default(autoincrement()) @map("Id")
  cedula      String       @unique @map("Cedula") @db.VarChar(20)
  name        String       @map("Nombre") @db.VarChar(100)
  apellido    String       @map("Apellido") @db.VarChar(100)
  telefono    String?      @map("Telefono") @db.VarChar(20)
  email       String?      @map("Email") @db.VarChar(100)
  direccion   String?      @map("Direccion") @db.VarChar(255)
  licencia    String?      @map("LicenciaNumero") @db.VarChar(50)
  status      Boolean      @default(true) @map("Estado")
  createdAt   DateTime     @default(now()) @map("FechaRegistro") @db.Date
  rents       Rent[]
  inspections Inspection[]

  @@map("Clientes")
}

model FuelType {
  id          Int       @id @default(autoincrement()) @map("Id")
  description String    @map("Descripcion") @db.VarChar(50)
  status      Boolean   @default(true) @map("Estado")
  vehicles    Vehicle[]

  @@map("Combustibles")
}

model Employee {
  id          Int          @id @default(autoincrement()) @map("Id")
  cedula      String       @unique @map("Cedula") @db.VarChar(20)
  name        String       @map("Nombre") @db.VarChar(100)
  apellido    String       @map("Apellido") @db.VarChar(100)
  telefono    String?      @map("Telefono") @db.VarChar(20)
  email       String?      @map("Email") @db.VarChar(100)
  cargo       String?      @map("Cargo") @db.VarChar(100)
  status      Boolean      @default(true) @map("Estado")
  hireDate    DateTime     @default(now()) @map("FechaAlta") @db.Date
  rents       Rent[]
  inspections Inspection[]
  role        Role?        @relation(fields: [roleId], references: [id])
  roleId      Int?

  @@map("Empleados")
}

model Inspection {
  id             Int      @id @default(autoincrement()) @map("Id")
  rentId         Int      @map("AlquilerId")
  vehicleId      Int      @map("VehiculoId")
  employeeId     Int      @map("EmpleadoId")
  customerId     Int      @map("ClienteId")
  tipoInspeccion String   @map("TipoInspeccion") @db.VarChar(20)
  nivelCombust   String?  @map("NivelCombust") @db.VarChar(20)
  kilometrajeKm  Int?     @map("KilometrajeKm")
  tieneRayones   Boolean  @default(false) @map("TieneRayones")
  tieneGolpes    Boolean  @default(false) @map("TieneGolpes")
  tieneRoturas   Boolean  @default(false) @map("TieneRoturas")
  observaciones  String?  @map("Observaciones") @db.VarChar(500)
  inspectionDate DateTime @default(now()) @map("FechaInspeccion")
  status         String   @map("Estado") @db.VarChar(20)
  rent           Rent     @relation(fields: [rentId], references: [id], onUpdate: NoAction)
  employee       Employee @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onUpdate: NoAction)
  customer       Customer @relation(fields: [customerId], references: [id], onUpdate: NoAction)

  @@map("Inspecciones")
}

model Brand {
  id          Int       @id @default(autoincrement()) @map("Id")
  description String    @map("Nombre") @db.VarChar(100)
  status      Boolean   @default(true) @map("Estado")
  models      Model[]
  vehicles    Vehicle[]

  @@map("Marcas")
}

model Model {
  id            Int         @id @default(autoincrement()) @map("Id")
  name          String      @map("Nombre") @db.VarChar(100)
  brandId       Int         @map("MarcaId")
  vehicleTypeId Int         @map("TipoVehiculoId")
  status        Boolean     @default(true) @map("Estado")
  brand         Brand       @relation(fields: [brandId], references: [id], onUpdate: NoAction)
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onUpdate: NoAction)
  vehicles      Vehicle[]

  @@map("Modelos")
}

model VehicleType {
  id          Int       @id @default(autoincrement()) @map("Id")
  description String    @map("Descripcion") @db.VarChar(100)
  status      Boolean   @default(true) @map("Estado")
  models      Model[]
  vehicles    Vehicle[]

  @@map("TipoVehiculos")
}

model Vehicle {
  id            Int          @id @default(autoincrement()) @map("Id")
  placa         String       @unique @map("Placa") @db.VarChar(20)
  modelId       Int          @map("ModeloId")
  brandId       Int          @map("BrandId")
  vehicleTypeId Int          @map("TipoVehiculoId")
  fuelTypeId    Int          @map("CombustibleId")
  anio          Int          @map("Anio")
  color         String       @map("Color") @db.VarChar(50)
  noChasis      String       @map("NoChasis") @db.VarChar(50)
  noMotor       String       @map("NoMotor") @db.VarChar(50)
  dailyRate     Decimal      @map("PrecioPorDia") @db.Decimal(10, 2)
  available     Boolean      @default(true) @map("Disponible")
  status        Boolean      @default(true) @map("Estado")
  rents         Rent[]
  inspections   Inspection[]
  fuelType      FuelType     @relation(fields: [fuelTypeId], references: [id], onUpdate: NoAction)
  model         Model        @relation(fields: [modelId], references: [id], onUpdate: NoAction)
  brand         Brand        @relation(fields: [brandId], references: [id], onUpdate: NoAction)
  vehicleType   VehicleType  @relation(fields: [vehicleTypeId], references: [id], onUpdate: NoAction)

  @@map("Vehiculos")
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String
  employees Employee[]
}
